echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting build environment"

DOTNET_RUNTIME=${DOTNET_RUNTIME}
if [ -z "${DOTNET_RUNTIME}" ]; then
	case "$(uname -m)" in
		x86_64)
			DOTNET_RUNTIME=linux-musl-x64
			;;
		aarch64)
			DOTNET_RUNTIME=linux-musl-arm64
			;;
	esac
fi
JELLYFIN_VERSION="$(wget https://github.com/jellyfin/jellyfin/releases.atom -q -O - | grep -A 1 -e 'link.*alternate' | grep -e '    <' | sed 'N;s/\n/ /' | grep -i -v alpha | grep -i -v beta | head -1 | sed 's%.*/tag/\([^"]*\).*%\1%')"
JELLYFIN_WEB_VERSION="$(wget https://github.com/jellyfin/jellyfin-web/releases.atom -q -O - | grep -A 1 -e 'link.*alternate' | grep -e '    <' | sed 'N;s/\n/ /' | grep -i -v alpha | grep -i -v beta | head -1 | sed 's%.*/tag/\([^"]*\).*%\1%')"
echo "Dotnet Runtime       : ${DOTNET_RUNTIME}"
echo "Jellyfin Version     : ${JELLYFIN_VERSION}"
echo "Jellyfin-Web Version : ${JELLYFIN_WEB_VERSION}"
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing jellyfin"
mkdir -p /app/jellyfin
mkdir -p /build
cd /build
#wget --no-check-certificate -q -O - https://github.com/jellyfin/jellyfin/archive/${JELLYFIN_VERSION}.tar.gz | tar zxf -
git clone https://github.com/jellyfin/jellyfin.git -b ${JELLYFIN_VERSION}
mv jellyfin jellyfin-git
cd jellyfin-*
#if [ ! -e /app/libskia/libSkiaSharp.so ]; then
#	sed -i -e "s/Include=\"SkiaSharp.NativeAssets.Linux\"/Include=\"StoneCold.SkiaSharp.NativeAssets.AlpineLinux\"/g" src/Jellyfin.Drawing.Skia/Jellyfin.Drawing.Skia.csproj #Patch for alpine linux
#fi
#dotnet publish Jellyfin.Server --configuration Release --output=/app/jellyfin --self-contained --runtime ${DOTNET_RUNTIME} "-p:GenerateDocumentationFile=false;DebugSymbols=false;DebugType=none"
dotnet publish Jellyfin.Server --configuration Release --output=/app/jellyfin --self-contained --runtime ${DOTNET_RUNTIME} "-p:DebugSymbols=false"
if [ -e /app/libskia/libSkiaSharp.so ]; then
	cp /app/libskia/libSkiaSharp.so /app/jellyfin/
fi
cd /
rm -rf /build
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

#echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing Jellyfin-Web"
#export GLIBC_LD_LINUX_SO='/lib64/ld-linux-x86-64.so.2'
#export GLIBC_LIBRARY_PATH='/lib/glibc'
#export LD_LIBRARY_PATH='/lib:/usr/lib:/lib/glibc'

cd /app/jellyfin
#wget --no-check-certificate -q -O - https://github.com/jellyfin/jellyfin-web/archive/${JELLYFIN_WEB_VERSION}.tar.gz | tar zxf - -C /app/jellyfin
git clone https://github.com/jellyfin/jellyfin-web.git -b ${JELLYFIN_WEB_VERSION}
mv jellyfin-web jellyfin-web-git
cd /app/jellyfin/jellyfin-web-*
npm install
npm run build:production
mv dist /app/jellyfin/jellyfin-web
cd /app/jellyfin
rm -rf /app/jellyfin/jellyfin-web-*
rm -rf bin
chmod 755 /app/jellyfin/jellyfin
cd /
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Moving output files"
mkdir -p /output
mv /app/jellyfin /output/
#mv /app/ffmpeg /output/
if [ -z "$(ls -A -- /app)" ]; then
	rm -rf /app
fi
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

