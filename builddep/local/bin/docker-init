#!/bin/sh

set -e

echo "==> Installing required packages"
PKG_DEV="yarn git"
docker-install -r -u ${PKG_DEV}
echo "==> OK"
echo

echo "==> Setting build environment"
DOTNET_RUNTIME=linux-musl-x64
JELLYFIN_VERSION="$(wget https://github.com/jellyfin/jellyfin/releases.atom -q -O - | grep -A 1 -e 'link.*alternate' | grep -v '\-rc' | grep -e '    <' | sed 'N;s/\n/ /' | head -1 | sed 's%.*/tag/\([^"]*\).*%\1%')"
JELLYFIN_WEB_VERSION="$(wget https://github.com/jellyfin/jellyfin-web/releases.atom -q -O - | grep -A 1 -e 'link.*alternate' | grep -v '\-rc' | grep -e '    <' | sed 'N;s/\n/ /' | head -1 | sed 's%.*/tag/\([^"]*\).*%\1%')"
echo "Dotnet Runtime       : ${DOTNET_RUNTIME}"
echo "Jellyfin Version     : ${JELLYFIN_VERSION}"
echo "Jellyfin-Web Version : ${JELLYFIN_WEB_VERSION}"
echo "==> OK"
echo

echo "==> Installing jellyfin"
mkdir -p /app/jellyfin
mkdir -p /build
cd /build
wget --no-check-certificate -q -O - https://github.com/jellyfin/jellyfin/archive/${JELLYFIN_VERSION}.tar.gz | tar zxf -
cd jellyfin-*
if [ ! -e /app/libskia/libSkiaSharp.so ]; then
	sed -i -e "s/Include=\"SkiaSharp.NativeAssets.Linux\"/Include=\"StoneCold.SkiaSharp.NativeAssets.AlpineLinux\"/g" Jellyfin.Drawing.Skia/Jellyfin.Drawing.Skia.csproj #Patch for alpine linux
fi
dotnet publish Jellyfin.Server --configuration Release --output=/app/jellyfin --self-contained --runtime ${DOTNET_RUNTIME} "-p:GenerateDocumentationFile=false;DebugSymbols=false;DebugType=none"
if [ -e /app/libskia/libSkiaSharp.so ]; then
	cp /app/libskia/libSkiaSharp.so /app/jellyfin/
fi
cd /
rm -rf /build
echo "==> OK"
echo

echo "==> Installing Jellyfin-Web"
cd /app/jellyfin
wget --no-check-certificate -q -O - https://github.com/jellyfin/jellyfin-web/archive/${JELLYFIN_WEB_VERSION}.tar.gz | tar zxf - -C /app/jellyfin
cd /app/jellyfin/jellyfin-web-*
patch -p1 < /usr/local/etc/playbackspeed-src-10.5.z.patch
yarn install
mv dist /app/jellyfin/jellyfin-web
cd /app/jellyfin
rm -rf /app/jellyfin/jellyfin-web-*
chmod 755 /app/jellyfin/jellyfin
cd /
echo "==> OK"
echo

echo "==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "==> OK"
echo

